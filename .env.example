# Square API Configuration
# Options for SQUARE_ENVIRONMENT: sandbox or production
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=your_square_sandbox_access_token_here
SQUARE_LOCATION_ID=

# Reporting Engine Settings
# Set USE_MOCK=true if you want to preview with simulated Upper Horton Sports Club data
USE_MOCK=false
DATABASE_PATH=data/club_sales.duckdb
APP_PORT=8501
CLUB_NAME="Upper Horton Sports Club"
